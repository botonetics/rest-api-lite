{
  "schemaVersion": 2,
  "templates": [
    {
      "id": "car-monitoring",
      "name": "Car Monitoring",
      "description": "Triggers an alert when a car disappears from the monitoring region for the configured number of consecutive analysed frames, or when a person enters it for the configured number of consecutive analysed frames.",
      "version": 2,
      "camera": {
        "type": "rtsp",
        "uri": "",
        "name": "",
        "username": null,
        "password": null
      },
      "modelId": "efficientdet-lite0-int8",
      "targetClasses": [
        "car",
        "person"
      ],
      "confidenceThreshold": 0.45,
      "regions": [
        {
          "id": "car-monitoring-zone",
          "name": "car-monitoring-zone",
          "shape": "boundingBox",
          "points": [
            {
              "x": 0.15,
              "y": 0.2
            },
            {
              "x": 0.85,
              "y": 0.85
            }
          ]
        }
      ],
      "alertPolicy": {
        "eventName": "Car Monitoring Alert",
        "alertType": "critical",
        "inAppEnabled": true,
        "operation": "or",
        "objectConditions": [
          {
            "className": "car",
            "trigger": "absent",
            "regionOperation": "or",
            "regionRules": [
              {
                "regionName": "car-monitoring-zone",
                "consecutiveFrames": 5
              }
            ]
          },
          {
            "className": "person",
            "trigger": "present",
            "regionOperation": "or",
            "regionRules": [
              {
                "regionName": "car-monitoring-zone",
                "consecutiveFrames": 5
              }
            ]
          }
        ]
      },
      "frameStrategy": {
        "type": "everyNthFrame",
        "nthFrame": 2,
        "intervalMs": 500
      },
      "retentionPolicy": {
        "snapshotRetentionDays": 3,
        "videoRetentionDays": 7,
        "maxStorageMb": 2048,
        "autoDelete": true
      },
      "saveSnapshots": true,
      "saveVideo": false,
      "editable": {
        "name": false,

        "cameraType": true,
        "cameraName": true,
        "cameraUri": true,
        "cameraUsername": true,
        "cameraPassword": true,

        "regions": true,
        "regionSelect": true,
        "regionMove": true,
        "regionZoom": true,
        "regionResize": false,
        "regionCreateBoundingBox": false,
        "regionCreatePolygon": false,
        "regionDelete": false,
        "regionRename": false,
        "regionShape": false,

        "model": false,
        "targetClasses": false,
        "frameStrategy": false,

        "consecutiveFrames": true,
        "confidenceThreshold": false,
        "eventName": false,
        "alertType": false,
        "conditionLogic": false,
        "alertRegionRules": false,
        "inAppEnabled": false,

        "retention": false
      }
    },
    {
      "id": "person-intrusion-region",
      "name": "Person Intrusion Region",
      "description": "Triggers an alert when a person is detected inside the intrusion region for the configured number of consecutive analysed frames.",
      "version": 2,
      "camera": {
        "type": "rtsp",
        "uri": "",
        "name": "",
        "username": null,
        "password": null
      },
      "modelId": "efficientdet-lite0-int8",
      "targetClasses": [
        "person"
      ],
      "confidenceThreshold": 0.5,
      "regions": [
        {
          "id": "intrusion-zone",
          "name": "intrusion-zone",
          "shape": "polygon",
          "points": [
            {
              "x": 0.3,
              "y": 0.5
            },
            {
              "x": 0.7,
              "y": 0.5
            },
            {
              "x": 0.95,
              "y": 0.9
            },
            {
              "x": 0.05,
              "y": 0.9
            }
          ]
        }
      ],
      "alertPolicy": {
        "eventName": "Person Intrusion Alert",
        "alertType": "critical",
        "inAppEnabled": true,
        "operation": "and",
        "objectConditions": [
          {
            "className": "person",
            "trigger": "present",
            "regionOperation": "or",
            "regionRules": [
              {
                "regionName": "intrusion-zone",
                "consecutiveFrames": 5
              }
            ]
          }
        ]
      },
      "frameStrategy": {
        "type": "everyNthFrame",
        "nthFrame": 2,
        "intervalMs": 500
      },
      "retentionPolicy": {
        "snapshotRetentionDays": 3,
        "videoRetentionDays": 7,
        "maxStorageMb": 2048,
        "autoDelete": true
      },
      "saveSnapshots": true,
      "saveVideo": false,
      "editable": {
        "name": false,

